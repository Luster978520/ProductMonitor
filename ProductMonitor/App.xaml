<Application x:Class="ProductMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProductMonitor"
             xmlns:system="clr-namespace:System;assembly=mscorlib"

             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionarys/btnStyleDic.xaml"/>
                <ResourceDictionary Source="/Dictionarys/groupBoxStyleDic.xaml"/>
                <ResourceDictionary Source="/Dictionarys/techGroupBoxStyleDic.xaml"/>
                <ResourceDictionary Source="/Dictionarys/workShopCardStyleDic.xaml"/>

              
            </ResourceDictionary.MergedDictionaries>

            <!-- ========== 新增字体资源 ========== -->
            <!-- 示例：思源黑体，改成你自己的字体内部名称 -->
            <FontFamily x:Key="MainFont">pack://application:,,,/Fonts/#FZSTK.TTF</FontFamily>
            <system:Double x:Key="FontSizeNormal">14</system:Double>
            <system:Double x:Key="FontSizeLarge">18</system:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
