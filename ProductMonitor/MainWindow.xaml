<Window x:Class="ProductMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductMonitor"
        mc:Ignorable="d"
        xmlns:liveCharts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        WindowStartupLocation="CenterScreen"
        Title="生产监控平台" Height="900" Width="1200">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="50"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <!-- 左上浅灰白 → 右下冷灰，斜向渐变更有层次 -->
            <GradientStop Color="Wheat" Offset="0"/>
            <GradientStop Color="#E2E8F0" Offset="0.5"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0 0 0 1" BorderBrush="Green">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/chatgpt二次元形象.jpg" />
                </Grid>
                <Grid Grid.Column="1">
                    <StackPanel Orientation="Vertical">
                        <TextBlock >
                        <Run Foreground="Black"  FontSize="20">生产监控平台</Run>
                        </TextBlock>
                        <TextBlock Margin="0 3 0 0 " HorizontalAlignment="Left" VerticalAlignment="Center" Text="好好学习，天天向上" FontSize="12"></TextBlock>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonBase}"
                                    ToolTip="最小化" AutomationProperties.Name="最小化"
                                    Click="MinimizeButton_Click">
                                <Path Data="M 1,6 L 11,6" Style="{StaticResource CaptionIconStyle}"/>
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeButtonStyle}"
                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                    Click="MaximizeButton_Click">
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource CaptionIconStyle}">
                                            <Setter Property="Data" Value="M 1,1 L 11,1 11,11 1,11 Z"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Data" Value="M 3,3 L 3,1 11,1 11,9 9,9 M 1,3 L 9,3 9,11 1,11 Z"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                                    ToolTip="关闭" AutomationProperties.Name="关闭"
                                    Click="CloseButton_Click">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Style="{StaticResource CaptionIconStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Border BorderThickness="0 1 0 0" BorderBrush="Green">
                            <Border.Background >
                                <VisualBrush TileMode="FlipXY" Viewport="0 0 7 7" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Line X1="0" Y1="10" X2="10" Y2="0" Stroke="Green" StrokeThickness="3"></Line>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>


        </Border>

        <!--内部-->

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="30" Background="Pink">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border>
                        <TextBlock Text="{Binding CurrentTime}" FontFamily="{StaticResource MainFont}"></TextBlock>
                    </Border>
                    <Border>
                        <TextBlock Text="{Binding NowDateTime}" FontFamily="{StaticResource MainFont}"></TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <StackPanel.Resources>
                        <DataTemplate x:Key="machineCount">
                            <Border Width="15" Background="Red" Margin="2,0">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"
                                           FontSize="16"></TextBlock>
                            </Border>
                        </DataTemplate>
                    </StackPanel.Resources>
                    <Border Background="Green">
                        <TextBlock Text="机台&#13;总数"></TextBlock>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MachineCount}" ItemTemplate="{StaticResource machineCount}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="Green" Margin="10 0 0 0">
                        <TextBlock Text="机台&#13;总数"></TextBlock>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MachineCount}" ItemTemplate="{StaticResource machineCount}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="Green" Margin="10 0 0 0">
                        <TextBlock Text="机台&#13;总数"></TextBlock>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MachineCount}" ItemTemplate="{StaticResource machineCount}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--<Border Background="Red" Width="30" Margin="10 0 0 0" >
                        <TextBlock Foreground="Wheat" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23"></TextBlock>
                    </Border>
                    <Border Background="Red" Margin="5 0 0 0" Width="30">
                        <TextBlock Foreground="Wheat" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23"></TextBlock>
                    </Border>
                    <Border Background="Red" Margin="5 0 0 0" Width="30">
                        <TextBlock Foreground="Wheat" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23"></TextBlock>
                    </Border>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <Button Content="配置" Style="{StaticResource ConfigurationButtonStyle}"/>
                </StackPanel>

            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,-10" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0"  >
                    
                   
                    <TextBlock Text="第一列"/>
                        <GroupBox Height="300" Header="环境" Margin="0,0,0,10" Padding="8" Style="{StaticResource MonitorGroupBoxStyle}">
                        <ItemsControl ItemsSource="{Binding  EnvironmentList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"></UniformGrid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5">
                                        <TextBlock Text="{Binding EnItemValue}" FontSize="16" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EnItemName}" FontSize="12" Foreground="#334155" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                        <GroupBox Height="280" Header="产能"  Margin="0,0,0,10" Style="{StaticResource MonitorGroupBoxStyle}">
                        <liveCharts:CartesianChart Height="250"
                                                   Series="{Binding ProductionSeries}"
                                                   XAxes="{Binding ProductionXAxes}"
                                                   YAxes="{Binding ProductionYAxes}"
                                                   LegendPosition="Top"/>
                    </GroupBox>
                    <GroupBox Header="质量"  Style="{StaticResource MonitorGroupBoxStyle}">
                        <liveCharts:CartesianChart Height="250"
                                                   Series="{Binding ProductionSeries2}"
                                                   XAxes="{Binding ProductionXAxes2}"
                                                   YAxes="{Binding ProductionYAxes2}"
                                                   Sections="{Binding QualityAlarmSections}"
                                                   >
                            
                        </liveCharts:CartesianChart>
                        
                    </GroupBox>
                </StackPanel>
                <Grid Grid.Column="1">
              
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0" Width="620" Height="300" Content="{Binding MonitorUC}">
                        </ContentControl>
                        <GroupBox Grid.Row="1" Width="620"   Margin="12,12,12,0" Padding="0"
                                  Style="{StaticResource MonitorGroupBoxStyle}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="报警记录"/>
                                    <TextBlock Margin="12,0,0,0" Foreground="#64748B" FontWeight="Normal"
                                               Text="{Binding AlarmRecordList.Count, StringFormat='共 {0} 条'}"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid Height="280" Margin="1,0,1,6">
                                <!-- 每条记录由 DataGrid 生成一行；限定高度，让滚动和行虚拟化生效。 -->
                                <DataGrid x:Name="AlarmRecordsGrid" ItemsSource="{Binding AlarmRecordList}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserReorderColumns="False" CanUserResizeRows="False"
                                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                          RowHeight="40" ColumnHeaderHeight="36" MinColumnWidth="50"
                                          Background="White" Foreground="#334155" BorderThickness="0"
                                          FontSize="13" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          AutomationProperties.Name="报警记录列表">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#075985"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F9FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                    <Setter Property="Foreground" Value="#075985"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="AlarmCellTextStyle" TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="序号" Binding="{Binding SN}" Width="60"
                                                            ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                        <DataGridTextColumn Header="报警内容" Binding="{Binding Alarm}" Width="*" MinWidth="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource AlarmCellTextStyle}">
                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="发生时间" Width="180"
                                                            Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                            ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                        <DataGridTextColumn Header="持续时间" Binding="{Binding DuringTime}" Width="100"
                                                            ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="暂无报警记录" Foreground="#94A3B8" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=AlarmRecordsGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </GroupBox>
                        <Grid Grid.Row="2" Margin="12,12,12,12">
                            <GroupBox Header="产品质量分布（示例数据）" Width="620"
                                      Style="{StaticResource MonitorGroupBoxStyle}">
                                <!-- 饼图使用 PieChart，只绑定 Series，不设置 XAxes / YAxes。 -->
                                <liveCharts:PieChart Height="260"
                                                     Series="{Binding ProductionSeries3}"
                                                     LegendPosition="Right"
                                                     LegendTextSize="14"
                                                     LegendTextPaint="{Binding ProductionLegendPaint}"
                                                     TooltipTextPaint="{Binding ProductionLegendPaint}"/>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!--<UniformGrid Grid.Column="2">
                      
                        <GroupBox Header="设备" >
                            </GroupBox>
                            <GroupBox Header="设备"></GroupBox>
                            <GroupBox Header="设备"></GroupBox>
                       
                    </UniformGrid>-->

                    <UniformGrid Grid.Column="2">
                        <StackPanel Orientation="Vertical">
                            <GroupBox Header="设备" Width="200" Height="300">
                                <ItemsControl ItemsSource="{Binding  EnvironmentList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"></UniformGrid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5">
                                                <TextBlock Text="{Binding EnItemValue}" FontSize="16" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding EnItemName}" FontSize="12" Foreground="#334155" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                            <GroupBox Height="280" Header="资源" Width="230" Margin="0,10,0,10" Padding="8"
                                      Style="{StaticResource MonitorGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="资源保障评分 · 示例" FontSize="12" Foreground="#64748B"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <!-- 极坐标图：角度轴放类别，半径轴放分数。 -->
                                    <liveCharts:PolarChart Height="230"
                                                           Series="{Binding ResourceSeries}"
                                                           AngleAxes="{Binding ResourceAngleAxes}"
                                                           RadiusAxes="{Binding ResourceRadiusAxes}"
                                                           InitialRotation="-90" LegendPosition="Hidden"
                                                           TooltipTextPaint="{Binding ProductionLegendPaint}"/>
                                    <TextBlock Text="0–100 分，越高越充足" FontSize="11" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="人力">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                      
                                            <TextBlock Text="870" FontSize="30"></TextBlock>
                                       
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"  Height="20" Text="人员"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding StaffResourceList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border  Grid.Column="0" Background="Orange" Width="10" Margin="2 2 2 2"></Border>
                                                        <TextBlock Grid.Column="1"  Text="{Binding staffName}" Margin="0 0 10 2"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Position}"  Margin="0 0 10 2"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                            <Border Background="Aqua" Height="3" Width="{Binding OutWorkDay}" Margin="0 0 10 0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding OutWorkDay}"  Margin="0 0 10 2"/>
                                                        </StackPanel>
                                                       
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </UniformGrid>

            </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding WorkShopList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"></UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WorkShopCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 标题区域：蓝色标记 + 车间名称 + 详情提示。 -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" Height="18" CornerRadius="2"
                                                    Background="#0284C7" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding WorkShopName}"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding WorkShopName}"/>
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0"  FontSize="12"  VerticalAlignment="Center">   
                                                <Hyperlink Foreground="#0369A1"
                                                           Command="{Binding DataContext.ShowDetailCmd, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                                           CommandParameter="{Binding}">详情 ›
                                                </Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F0F7FC" CornerRadius="8" Padding="6,12"
                                                Margin="0,0,12,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="机台总数" FontSize="12" Foreground="#64748B"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Totle}" FontSize="32" FontWeight="SemiBold"
                                                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Grid.Column="1" Rows="2" Columns="2">
                                            <StackPanel Margin="2,0,2,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WorkShopCount}" Foreground="#047857"
                                                           Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                <TextBlock Text="作业" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="2,0,2,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WaitCount}" Foreground="#B45309"
                                                           Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                <TextBlock Text="等待" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="2,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WrongCount}" Foreground="#DC2626"
                                                           Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                <TextBlock Text="故障" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="2,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StopCount}" Foreground="#475569"
                                                           Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                <TextBlock Text="停机" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        </Grid>

        <!-- 页脚：左侧使用剩余宽度，右侧按版权文字所需宽度排列。 -->
        <Border Grid.Row="2" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="0,1,0,0"
                Padding="16,9" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                        <TextBlock Text="PM" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="生产监控平台" FontSize="12"
                               Foreground="#475569" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <!-- 将 xxxxxx 替换为实际公司或版权方名称。 -->
                <TextBlock Grid.Column="1" Text="© xxxxxx · 版权所有" FontSize="12"
                           Foreground="#64748B" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

    </Grid>
</Window>
