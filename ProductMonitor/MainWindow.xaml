<Window x:Class="ProductMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductMonitor"
        xmlns:views="clr-namespace:ProductMonitor.UserControls"
        mc:Ignorable="d"
        xmlns:liveCharts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        WindowStartupLocation="CenterScreen"
        Title="生产监控平台" Height="900" Width="1200" Background="#F1F5F9"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="50"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"  Background="White" BorderBrush="#D5E0E9" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="/Resources/Images/chatgpt二次元形象.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Grid.Column="1" Text="生产监控平台" Margin="10,0,0,0"
                           FontSize="18" FontWeight="SemiBold" Foreground="#18364A"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonBase}"
                            ToolTip="最小化" AutomationProperties.Name="最小化"
                            Click="MinimizeButton_Click">
                        <Path Data="M 1,6 L 11,6" Style="{StaticResource CaptionIconStyle}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeButtonStyle}"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Click="MaximizeButton_Click">
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource CaptionIconStyle}">
                                    <Setter Property="Data" Value="M 1,1 L 11,1 11,11 1,11 Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Data" Value="M 3,3 L 3,1 11,1 11,9 9,9 M 1,3 L 9,3 9,11 1,11 Z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                            ToolTip="关闭" AutomationProperties.Name="关闭"
                            Click="CloseButton_Click">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Style="{StaticResource CaptionIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 看板和车间卡片按内容高度顺序排列，共用一个滚动区域。 -->
        <ScrollViewer x:Name="DashboardContent" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" CanContentScroll="False">
            <Grid MinWidth="960" Width="{Binding ViewportWidth, ElementName=DashboardContent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="生产概览" FontSize="20" FontWeight="SemiBold" Foreground="#18364A"
                                   VerticalAlignment="Center"/>
                        <Border Margin="14,0" Width="1" Height="20" Background="#C8D6E2" VerticalAlignment="Center"/>
                        <TextBlock Text="机台总数" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MachineCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#075985" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowDateTime}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="8,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="配置" Style="{StaticResource ConfigurationButtonStyle}"  Height="30"
                                Click="OpenSettings_Click" Margin="0 0 10 0"/>
                        <Button Content="实时读取数据" Style="{StaticResource ConfigurationButtonStyle}" Margin="0" Height="30"/>
                    </StackPanel>
                </Grid>
                <!-- 各模块共用行列定义及间隔，车间卡片位于看板之后的独立行。 -->
                <Grid Grid.Row="1" Margin="16,0,16,0">
                    <Grid.Resources>
                        <ItemsPanelTemplate x:Key="IndicatorPanel">
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                        <DataTemplate x:Key="IndicatorTile">
                            <Border Margin="2" CornerRadius="5" Background="#F1F6FA" Padding="2,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EnItemValue}" Foreground="#085A78" FontSize="19"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding EnItemName}" FontSize="11" Foreground="#475569"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="192"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="230"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="222"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Column="0" Header="环境" Padding="8">
                        <ItemsControl ItemsSource="{Binding EnvironmentList}" ItemsPanel="{StaticResource IndicatorPanel}"
                                      ItemTemplate="{StaticResource IndicatorTile}"/>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="监控画面" Padding="8">
                        <ContentControl Content="{Binding MonitorUC}" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </GroupBox>
                    <GroupBox Grid.Column="4" Header="设备环境" Padding="8">
                        <ItemsControl ItemsSource="{Binding EnvironmentList}" ItemsPanel="{StaticResource IndicatorPanel}"
                                      ItemTemplate="{StaticResource IndicatorTile}"/>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="产能" Padding="6">
                        <liveCharts:CartesianChart Series="{Binding ProductionSeries}"
                                                   XAxes="{Binding ProductionXAxes}" YAxes="{Binding ProductionYAxes}"
                                                   LegendPosition="Top" LegendTextSize="12"
                                                   LegendTextPaint="{Binding ProductionLegendPaint}"/>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="2" Padding="0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="报警记录"/>
                                <TextBlock Margin="10,0,0,0" Foreground="#64748B" FontWeight="Normal"
                                           Text="{Binding AlarmRecordList.Count, StringFormat='共 {0} 条'}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid Margin="1,0,1,4">
                            <DataGrid x:Name="AlarmRecordsGrid" ItemsSource="{Binding AlarmRecordList}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowHeight="27" ColumnHeaderHeight="28" MinColumnWidth="40"
                                      Background="White" Foreground="#334155" BorderThickness="0"
                                      FontSize="12" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="报警记录列表">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="7,0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="7,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#075985"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                <Setter Property="Foreground" Value="#075985"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="AlarmCellTextStyle" TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding SN}" Width="44"
                                                        ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                    <DataGridTextColumn Header="报警内容" Binding="{Binding Alarm}" Width="*" MinWidth="76">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AlarmCellTextStyle}">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="发生时间" Width="145"
                                                        Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                        ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                    <DataGridTextColumn Header="持续时间" Binding="{Binding DuringTime}" Width="66"
                                                        ElementStyle="{StaticResource AlarmCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="暂无报警记录" Foreground="#94A3B8" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=AlarmRecordsGrid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="4" Header="资源保障评分" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <liveCharts:PolarChart Series="{Binding ResourceSeries}" AngleAxes="{Binding ResourceAngleAxes}"
                                                   RadiusAxes="{Binding ResourceRadiusAxes}" InitialRotation="-90"
                                                   LegendPosition="Hidden" TooltipTextPaint="{Binding ProductionLegendPaint}"/>
                            <TextBlock Grid.Row="1" Text="示例评分 · 0–100 分" Foreground="#64748B" FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Header="质量" Padding="6">
                        <liveCharts:CartesianChart Series="{Binding ProductionSeries2}" XAxes="{Binding ProductionXAxes2}"
                                                   YAxes="{Binding ProductionYAxes2}" Sections="{Binding QualityAlarmSections}"/>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Grid.Column="2" Header="产品质量分布（示例数据）" Padding="8">
                        <liveCharts:PieChart Series="{Binding ProductionSeries3}" LegendPosition="Right" LegendTextSize="13"
                                             LegendTextPaint="{Binding ProductionLegendPaint}" TooltipTextPaint="{Binding ProductionLegendPaint}"/>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Grid.Column="4" Header="人力" Padding="12,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="870" FontSize="24" FontWeight="SemiBold" Foreground="#12324A"/>
                                <TextBlock Text="人" Margin="4,0,0,3" VerticalAlignment="Bottom" Foreground="#526578"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding StaffResourceList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,4" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding staffName}" Foreground="#253C4F"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Position}" Foreground="#526578"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OutWorkDay, StringFormat='{}{0} 天'}"
                                                           Foreground="#0369A1"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </GroupBox>
                </Grid>
                <Grid Grid.Row="2" Margin="16,16,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="车间概览" FontSize="16" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,0,0,10"/>
                    <!-- 容器抵消首尾半个列间距，卡片边缘与上方看板对齐。 -->
                    <ItemsControl Grid.Row="1" Margin="-6,0" ItemsSource="{Binding WorkShopList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="6,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkShopCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WorkShopName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding WorkShopName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12">
                                                <Hyperlink Foreground="#0369A1" Command="{Binding DataContext.ShowDetailCmd, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           CommandParameter="{Binding}">详情 ›</Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                            <TextBlock Text="{Binding Totle}" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="机台总数" FontSize="12" Foreground="#475569"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,5"/>
                                        </StackPanel>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,8,0,0">
                                            <UniformGrid Rows="1" Columns="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WorkShopCount}" Foreground="#047857" Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                    <TextBlock Text="作业" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WaitCount}" Foreground="#A16207" Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                    <TextBlock Text="等待" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WrongCount}" Foreground="#B91C1C" Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                    <TextBlock Text="故障" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StopCount}" Foreground="#475569" Style="{StaticResource WorkShopMetricNumberStyle}"/>
                                                    <TextBlock Text="停机" Style="{StaticResource WorkShopMetricLabelStyle}"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- 页脚：左侧使用剩余宽度，右侧按版权文字所需宽度排列。 -->
        <Border Grid.Row="2" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="0,1,0,0"
                Padding="16,9" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                        <TextBlock Text="PM" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="生产监控平台" FontSize="12"
                               Foreground="#475569" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <!-- 将 xxxxxx 替换为实际公司或版权方名称。 -->
                <TextBlock Grid.Column="1" Text="© xxxxxx · 版权所有" FontSize="12"
                           Foreground="#64748B" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 覆盖内容和页脚，标题栏仍可操作。超出底边的动画部分由宿主裁掉。 -->
        <Grid x:Name="DetailLayer" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="1"
              Visibility="Collapsed" ClipToBounds="True" Background="#550F172A"
              KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="DetailLayer_PreviewKeyDown">
            <Border x:Name="DetailPanel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#F8FAFC" CornerRadius="14,14,0,0"
                    BorderBrush="#CBD5E1" BorderThickness="1,1,1,0"
                     DataContext="{x:Null}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DetailOffset"/>
                </Border.RenderTransform>
                <DockPanel Margin="0,12,0,0">
                    <Button x:Name="CloseDetailButton" DockPanel.Dock="Top" Content="关闭详情"
                            HorizontalAlignment="Right" Margin="0,0,24,0" Padding="12,4"
                            Click="CloseDetail_Click"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <views:WorkShopDetailUC/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
