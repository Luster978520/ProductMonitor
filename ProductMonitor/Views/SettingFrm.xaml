<Window x:Class="ProductMonitor.Views.SettingFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统配置信息" Width="1000" Height="650" MinWidth="700" MinHeight="480"
        Background="#F1F5F9" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SettingsMenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6"
                                Margin="10,3" Padding="16,13" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0369A1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#D5E0E9" BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="系统配置信息" FontSize="19" FontWeight="SemiBold" Foreground="#18364A"/>
                <TextBlock Text="管理设备与检测配置" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D5E0E9" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="配置菜单" Margin="26,22,0,10" FontSize="12" Foreground="#94A3B8"/>
                <ListBox x:Name="SettingsMenu" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource SettingsMenuItemStyle}"
                         SelectionChanged="SettingsMenu_SelectionChanged">
                    <ListBoxItem Content="设备清单"/>
                    <ListBoxItem Content="环境检测"/>
                    <ListBoxItem Content="设备检测"/>
                    <ListBoxItem Content="协议连接"/>
                    <ListBoxItem Content="配置二"/>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="24" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ContentTitle" FontSize="20" FontWeight="SemiBold" Foreground="#18364A"/>
                <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,18,0,22"/>
                <ContentControl x:Name="SettingsContent" Grid.Row="2" Foreground="#64748B" FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>

