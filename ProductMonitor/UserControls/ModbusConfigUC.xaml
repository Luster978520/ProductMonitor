<UserControl x:Class="ProductMonitor.UserControls.ModbusConfigUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="AliceBlue">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Modbus RTU 串口连接" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <WrapPanel><TextBlock Text="串口" Margin="4"/><ComboBox x:Name="Ports" Width="90" Margin="4"/><Button Content="刷新" Click="Refresh_Click" Margin="4"/><TextBlock Text="波特率" Margin="4"/><ComboBox x:Name="Baud" Width="90" Margin="4"/><TextBlock Text="数据位" Margin="4"/><ComboBox x:Name="Bits" Width="65" Margin="4"/><TextBlock Text="校验位" Margin="4"/><ComboBox x:Name="ParityBox" Width="80" Margin="4"/><TextBlock Text="停止位" Margin="4"/><ComboBox x:Name="Stops" Width="80" Margin="4"/></WrapPanel>
  <WrapPanel Margin="0,8"><Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" Padding="18,5"/><TextBlock x:Name="Status" Text="未连接" Margin="12,5"/></WrapPanel>
  <Separator Margin="0,10"/><TextBlock Text="读写操作" FontSize="17" FontWeight="SemiBold"/>
  <WrapPanel Margin="0,8"><TextBlock Text="从站地址 (1–247)" Margin="4"/><TextBox x:Name="Slave" Text="1" Width="55" Margin="4"/><TextBlock Text="起始地址 (0–65535)" Margin="4"/><TextBox x:Name="Address" Text="0" Width="70" Margin="4"/><TextBlock Text="读取数量" Margin="4"/><TextBox x:Name="Count" Text="1" Width="60" Margin="4"/></WrapPanel>
  <WrapPanel><TextBlock Text="功能" Margin="4"/><ComboBox x:Name="Function" Width="220" Margin="4"/><TextBlock Text="写入值（逗号分隔）" Margin="4"/><TextBox x:Name="Values" Text="0" Width="160" Margin="4"/><Button x:Name="ExecuteButton" Content="执行" Click="Execute_Click" Padding="18,4" Margin="4"/></WrapPanel>
  <TextBlock Text="线圈值使用 0 或 1；寄存器值使用 0–65535。写入操作会改变设备状态。" TextWrapping="Wrap" Margin="4,8"/>
  <TextBlock Text="执行结果" FontWeight="SemiBold" Margin="4"/><TextBox x:Name="Result" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto"/>
 </StackPanel></ScrollViewer>
</UserControl>
