<UserControl x:Class="ProductMonitor.UserControls.RingUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductMonitor.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="LayOutGrid">
        <Ellipse Width="{Binding ElementName=LayOutGrid,Path=ActualWidth}"
                 Height="{Binding ElementName=LayOutGrid,Path=ActualHeight}"
                 StrokeThickness="5"
                 Stroke="White"></Ellipse>
        <Path x:Name="path" Stroke="Orange" StrokeThickness="10" StrokeStartLineCap="Round"></Path>

        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue" >
            <Run Text="{Binding PercentValue,RelativeSource={RelativeSource AncestorType=UserControl},StringFormat={}{0:#.#}}" FontSize="20"></Run>
            <Run Text="%"/>
        </TextBlock>
    </Grid>
</UserControl>
